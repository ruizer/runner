    {
      "type": "frame",
      "id": "e6DOR",
      "x": 0,
      "y": 1160,
      "name": "793 — Liquid glass · exploration guide",
      "width": 5040,
      "height": 200,
      "layout": "vertical",
      "gap": 14,
      "padding": [
        24,
        0
      ],
      "children": [
        {
          "type": "text",
          "id": "t0jYz",
          "name": "Exploration title",
          "fill": "#EDEEF3",
          "content": "793 / Liquid glass",
          "fontFamily": "Inter",
          "fontSize": 44,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "qFGIu",
          "name": "Exploration subtitle",
          "fill": "#A6ACBA",
          "content": "Frosted glass chrome, solid terminal surfaces and polished floating controls. Review light, dark and solid appearance.",
          "fontFamily": "Inter",
          "fontSize": 20,
          "fontWeight": "normal"
        },
